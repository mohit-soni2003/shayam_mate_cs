PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:5173

# Supabase (Database + Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time secret required by POST /api/v1/auth/register-admin (Postman-only bootstrap)
ADMIN_SETUP_KEY=

# Cloudinary (file / PDF storage) - wired up when the Documents module is built
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (used to email new landing-page leads) - same Gmail + App Password
# already configured as Supabase's custom SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where new "Get in Touch" leads get emailed. Change any time, no code change needed.
LEAD_NOTIFICATION_EMAIL=mohitsoni1847@gmail.com

# Gemini (AI document analysis — runs on every upload, see documentAi.service.js)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Razorpay (client-side invoice payment) - from the Razorpay dashboard's API Keys section
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
